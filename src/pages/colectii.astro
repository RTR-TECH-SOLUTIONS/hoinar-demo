---
import Base from '../layouts/Base.astro';
import Lista from '../components/pagini/Lista.astro';
import { getProduse } from '../lib/catalog';

const produse = await getProduse('ro', {});
---
<Base lang="ro" titlu="Tot ce facem — HOINAR" descriere="Toate accesoriile de plimbare HOINAR: hamuri, lese, zgărzi, genți și accesorii, în patru țesături. Filtrează după culoare, mărime și preț.">
  <Lista lang="ro" titlu="Tot ce facem" intro="Patru țesături, opt piese. Filtrează după ce ai nevoie." produse={produse} />
</Base>
