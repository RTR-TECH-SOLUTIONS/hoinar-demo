---
import Base from '../layouts/Base.astro';
---
<Base lang="ro" titlu="Pagina nu există — HOINAR">
  <div class="container-brand flex min-h-[46svh] flex-col items-center justify-center py-20 text-center">
    <p class="font-[family-name:var(--font-serif)] text-[4rem] leading-none text-camel">404</p>
    <h1 class="mt-4" style="font-size: var(--pas-2xl)">Aici nu e nimic</h1>
    <p class="mt-3 max-w-[42ch] text-ciocolata/75">
      Pagina s-a mutat sau n-a existat niciodată. Se întâmplă.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/colectii" class="rounded-[10px] bg-ink px-7 py-3.5 text-[0.92rem] text-crem transition-colors hover:bg-ciocolata">
        Vezi tot ce facem
      </a>
      <a href="/" class="rounded-[10px] border border-linie px-7 py-3.5 text-[0.92rem] transition-colors hover:border-ciocolata">
        Acasă
      </a>
    </div>
  </div>
</Base>
