---
import Base from '../../layouts/Base.astro';
---
<Base lang="en" titlu="Page not found — HOINAR">
  <div class="container-brand flex min-h-[46svh] flex-col items-center justify-center py-20 text-center">
    <p class="apare font-[family-name:var(--font-serif)] text-[4rem] leading-none text-camel">404</p>
    <h1 class="apare mt-4" style="font-size: var(--pas-2xl); --pas: 90ms">Nothing here</h1>
    <p class="apare mt-3 max-w-[42ch] text-ciocolata/75" style="--pas: 160ms">
      The page moved, or it never existed. It happens.
    </p>
    <div class="apare mt-8 flex flex-wrap justify-center gap-3" style="--pas: 230ms">
      <a href="/en/colectii" class="rounded-[10px] bg-ink px-7 py-3.5 text-[0.92rem] text-crem transition-[background-color,transform] duration-200 hover:bg-ciocolata active:scale-[0.97]">
        See everything we make
      </a>
      <a href="/en/" class="rounded-[10px] border border-linie px-7 py-3.5 text-[0.92rem] transition-colors duration-200 hover:border-ciocolata">
        Home
      </a>
    </div>
  </div>
</Base>
