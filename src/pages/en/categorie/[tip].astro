---
import Base from '../../../layouts/Base.astro';
import Lista from '../../../components/pagini/Lista.astro';
import { getProduse, getTipuri } from '../../../lib/catalog';

export async function getStaticPaths() {
  const tipuri = await getTipuri('en');
  return Promise.all(
    tipuri.map(async (tip) => ({
      params: { tip: tip.slug },
      props: { tip, produse: await getProduse('en', { tip: tip.slug }) },
    })),
  );
}

const { tip, produse } = Astro.props;
---
<Base lang="en" titlu={`${tip.nume} — HOINAR`}>
  <Lista lang="en" titlu={tip.nume} produse={produse} ascunde={['tip']} />
</Base>
