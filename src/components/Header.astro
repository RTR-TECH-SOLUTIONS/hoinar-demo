---
import { getImage, Image } from 'astro:assets';
import { getImagine } from '../lib/imagini';
import { getColectii, getTipuri, getProduse, getReduceri } from '../lib/catalog';
import { getMeniu } from '../lib/meniu';
import { traduceri, url, comuta } from '../lib/i18n';
import type { Limba } from '../lib/pret';
import CosButon from './CosButon.tsx';
import SelectorMoneda from './SelectorMoneda.tsx';
import FavoriteButon from './FavoriteButon.tsx';
import Cautare from './Cautare.tsx';
import BaraPromo from './BaraPromo.astro';

interface Props { lang: Limba; pathname: string }
const { lang, pathname } = Astro.props;
const t = traduceri(lang);
const ro = lang === 'ro';
const u = (c: string) => url(lang, c);

const colectii = await getColectii(lang);
const tipuri = await getTipuri(lang);
const produse = await getProduse(lang, {});
const reduceri = await getReduceri(lang, 1);

async function src(cale: string, w: number) {
  return (await getImage({ src: getImagine(cale), width: w, format: 'webp' })).src;
}

const numeColectie = new Map(colectii.map((c) => [c.slug, c.nume]));
const indexCautare = await Promise.all(
  produse.map(async (p) => ({
    slug: p.slug,
    nume: p.nume,
    tipNume: p.tipNume,
    colectieNume: numeColectie.get(p.colectie) ?? '',
    pretRon: p.pretRon,
    pretVechiRon: p.pretVechiRon,
    img: await src(p.imagini[0], 90),
    url: u(`/produs/${p.slug}`),
  })),
);

const meniu = await getMeniu(lang);

const promoMega = reduceri[0];
const social = [
  ['Instagram', 'https://instagram.com'],
  ['Facebook', 'https://facebook.com'],
  ['TikTok', 'https://tiktok.com'],
];
---

<!-- 1. bară utilitară -->
<div class="hidden border-b border-linie/60 bg-crem lg:block">
  <div class="container-brand flex h-10 items-center justify-between text-[0.75rem] text-ciocolata/70">
    <a href="tel:+40721000000" class="transition-colors hover:text-teracota">0721 000 000</a>
    <div class="flex items-center gap-4">
      {social.map(([nume, href]) => (
        <a href={href} rel="noopener noreferrer" target="_blank" class="transition-colors hover:text-teracota">{nume}</a>
      ))}
      <span aria-hidden="true" class="text-linie">|</span>
      <a
        href={comuta(pathname, ro ? 'en' : 'ro')}
        class="underline underline-offset-4 transition-colors hover:text-teracota"
        hreflang={ro ? 'en' : 'ro'}
      >{ro ? 'English' : 'Română'}</a>
      <SelectorMoneda client:idle eticheta={t('footer.moneda')} />
    </div>
  </div>
</div>

<header class="sticky top-0 z-50 bg-crem/97 backdrop-blur-sm" data-header data-strans="nu">
  <!-- 2. rândul principal: logo stânga, căutare centru, acțiuni dreapta -->
  <div class="container-brand grid h-[var(--rand-logo)] grid-cols-[auto_1fr_auto] items-center gap-4 transition-[height] duration-200 ease-out lg:gap-10">
    <div class="flex items-center gap-3">
      <button
        type="button"
        class="-ml-1 grid h-10 w-10 place-items-center rounded-[8px] transition-colors hover:bg-nisip lg:hidden"
        data-meniu-mobil
        aria-expanded="false"
        aria-controls="meniu-mobil"
        aria-label={t('actiune.meniu')}
      >
        <svg viewBox="0 0 20 20" width="21" height="21" aria-hidden="true" class="fill-none stroke-current" stroke-width="1.6" data-icon-meniu>
          <path d="M3 6h14M3 10h14M3 14h14" stroke-linecap="round" />
        </svg>
      </button>

      <a href={u('/')} aria-label="HOINAR" class="shrink-0">
        <span class="block font-[family-name:var(--font-serif)] leading-[0.95] tracking-[0.18em] text-ciocolata" style="font-size: var(--wordmark)">
          HOINAR
        </span>
        <span class="mt-1 block text-[0.58rem] tracking-[0.38em] text-ciocolata/55 md:text-[0.64rem]" data-sub>
          {t('header.sub')}
        </span>
      </a>
    </div>

    <div class="hidden justify-self-center lg:block lg:w-full lg:max-w-[30rem]">
      <Cautare
        client:idle
        index={indexCautare}
        placeholder={t('cauta.placeholder')}
        eticheta={t('actiune.cauta')}
        nimic={t('cauta.nimic')}
        toate={t('cauta.toate')}
        urlToate={u('/colectii')}
      />
    </div>

    <div class="flex items-center gap-4 justify-self-end text-[0.85rem] sm:gap-5">
      <button
        type="button"
        class="grid h-10 w-10 place-items-center rounded-[8px] transition-colors hover:bg-nisip lg:hidden"
        data-cauta-comuta
        aria-expanded="false"
        aria-controls="panou-cautare"
        aria-label={t('actiune.cauta')}
      >
        <svg viewBox="0 0 16 16" width="17" height="17" aria-hidden="true" class="fill-none stroke-current" stroke-width="1.5">
          <circle cx="7" cy="7" r="5" />
          <path d="M11 11l4 4" stroke-linecap="round" />
        </svg>
      </button>

      <FavoriteButon client:idle eticheta={t('actiune.favorite')} href={u('/favorite')} />
      <a href={u('/cont')} class="hidden items-center gap-2 transition-colors hover:text-teracota sm:inline-flex">
        <svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true" class="fill-none stroke-current" stroke-width="1.4">
          <circle cx="9" cy="6" r="3.2" />
          <path d="M2.8 16c0-3.4 2.8-5.2 6.2-5.2s6.2 1.8 6.2 5.2" stroke-linecap="round" />
        </svg>
        <span class="hidden xl:inline">{t('actiune.cont')}</span>
      </a>
      <CosButon client:load eticheta={t('actiune.cos')} />
    </div>
  </div>

  <!-- panou de căutare, se deschide din iconiță -->
  <div id="panou-cautare" hidden class="border-t border-linie/60 bg-crem">
    <div class="container-brand py-4">
      <Cautare
        client:idle
        index={indexCautare}
        placeholder={t('cauta.placeholder')}
        eticheta={t('actiune.cauta')}
        nimic={t('cauta.nimic')}
        toate={t('cauta.toate')}
        urlToate={u('/colectii')}
      />
    </div>
  </div>

  <!-- 3. rândul de categorii, cu panouri pe toată lățimea -->
  <nav class="relative hidden border-t border-linie/60 lg:block" data-nav aria-label={t('actiune.meniu')}>
    <div data-rand-nav class="container-brand flex h-[var(--rand-nav)] items-center justify-center gap-8 text-[0.76rem] tracking-[0.13em]">
      {meniu.map((m) => (
        <a
          href={m.href}
          data-mega={m.coloane ? m.slug : undefined}
          aria-haspopup={m.coloane ? 'true' : undefined}
          class={`inline-flex items-center gap-1.5 whitespace-nowrap uppercase transition-colors hover:text-teracota ${m.accent ? 'text-teracota' : ''}`}
        >
          {m.eticheta}
          {m.coloane && <span aria-hidden="true" class="text-[0.55rem] opacity-55">▾</span>}
        </a>
      ))}
    </div>

    {meniu.filter((m) => m.coloane).map((m) => (
      <div
        class="mega absolute left-0 right-0 top-full z-10 border-y border-linie bg-crem shadow-[0_20px_44px_-24px_rgba(24,22,19,0.45)]"
        data-panou={m.slug}
      >
        <div class="container-brand grid grid-cols-5 gap-6 py-7 tracking-normal">
          {m.coloane!.map((col) => (
            <div>
              <a href={col.linkuri[0].href} aria-label={col.titlu} class="group/i block overflow-hidden rounded-[10px] bg-nisip">
                <Image
                  src={getImagine(col.imagine)}
                  alt=""
                  widths={[240, 480]}
                  sizes="240px"
                  class="aspect-[4/3] w-full object-cover transition-transform duration-300 ease-out group-hover/i:scale-[1.04]"
                />
              </a>
              <p class="mt-3 text-[0.72rem] uppercase tracking-[0.12em] text-ciocolata">{col.titlu}</p>
              <ul class="mt-2.5 space-y-1.5">
                {col.linkuri.map((l) => (
                  <li>
                    <a href={l.href} class="text-[0.85rem] normal-case text-ciocolata/75 transition-colors hover:text-teracota">
                      {l.eticheta}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    ))}
  </nav>

</header>


<!-- meniu mobil: în afara <header>, altfel `fixed` se raportează la header,
     pentru că backdrop-blur creează bloc de referință pentru poziționare -->
  <div
    id="meniu-mobil"
    hidden
    class="fixed inset-x-0 bottom-0 top-[var(--rand-logo)] z-40 overflow-y-auto overscroll-contain border-t border-linie bg-crem lg:hidden"
  >
    <div class="container-brand py-4">
      <Cautare client:idle index={indexCautare} placeholder={t('cauta.placeholder')} eticheta={t('actiune.cauta')}
        nimic={t('cauta.nimic')} toate={t('cauta.toate')} urlToate={u('/colectii')} />
    </div>
    <nav class="container-brand pb-4" aria-label={t('actiune.meniu')}>
      <a href={u('/reduceri')} class="flex items-center gap-2 border-b border-linie/60 py-3 text-[0.95rem] font-medium text-teracota">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-teracota" aria-hidden="true"></span>
        {t('nav.reduceri')}
      </a>
      {meniu.filter((m) => m.coloane).map((m) => (
        <details class="group border-b border-linie/60">
          <summary class="flex cursor-pointer list-none items-center justify-between py-3.5 text-[0.95rem] marker:content-none">
            {m.eticheta}
            <span aria-hidden="true" class="text-[1.05rem] leading-none text-ciocolata/45 transition-transform duration-200 group-open:rotate-45">+</span>
          </summary>
          <div class="pb-3 pl-1">
            {m.coloane!.slice(0, 3).map((col) => (
              <div class="mb-3">
                <p class="text-[0.72rem] uppercase tracking-[0.12em] text-ciocolata/55">{col.titlu}</p>
                <ul class="mt-1.5 space-y-1.5">
                  {col.linkuri.map((l) => (
                    <li><a href={l.href} class="text-[0.88rem] text-ciocolata/80">{l.eticheta}</a></li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </details>
      ))}
      <a href={u('/favorite')} class="block border-b border-linie/60 py-3.5 text-[0.95rem]">{t('actiune.favorite')}</a>
      <a href={u('/cos')} class="block border-b border-linie/60 py-3.5 text-[0.95rem]">{t('cos.titlu')}</a>
      <a href={u('/cont')} class="block border-b border-linie/60 py-3.5 text-[0.95rem]">{t('actiune.cont')}</a>
      <a href={u('/ghid-marimi')} class="block border-b border-linie/60 py-3.5 text-[0.95rem]">{t('produs.ghid')}</a>
      <a href={u('/poveste')} class="block border-b border-linie/60 py-3.5 text-[0.95rem]">{t('nav.poveste')}</a>
      <a href={u('/livrare-retur')} class="block border-b border-linie/60 py-3.5 text-[0.95rem]">{t('produs.livrare')}</a>
      <a href={u('/contact')} class="block py-3.5 text-[0.95rem]">Contact</a>

      <div class="mt-6 flex items-center gap-4 border-t border-linie pt-5 text-[0.85rem] text-ciocolata/70">
        <a href="tel:+40721000000" class="hover:text-teracota">0721 000 000</a>
        <span aria-hidden="true" class="text-linie">|</span>
        <a href={comuta(pathname, ro ? 'en' : 'ro')} class="underline underline-offset-4 hover:text-teracota">
          {ro ? 'English' : 'Română'}
        </a>
      </div>
    </nav>
  </div>

<!-- 4. banda de promoții, sub header, ca la referință -->
<BaraPromo lang={lang} />

<script>
  const buton = document.querySelector<HTMLButtonElement>('[data-meniu-mobil]');
  const panou = document.getElementById('meniu-mobil');
  buton?.addEventListener('click', () => {
    const deschis = buton.getAttribute('aria-expanded') === 'true';
    buton.setAttribute('aria-expanded', String(!deschis));
    if (panou) panou.hidden = deschis;
    const icon = buton.querySelector<SVGPathElement>('[data-icon-meniu] path');
    if (icon) icon.setAttribute('d', deschis ? 'M3 6h14M3 10h14M3 14h14' : 'M5 5l10 10M15 5L5 15');
    document.body.style.overflow = deschis ? '' : 'hidden';
  });

  const inchideMeniu = () => {
    if (!buton || !panou || panou.hidden) return;
    buton.setAttribute('aria-expanded', 'false');
    panou.hidden = true;
    const icon = buton.querySelector<SVGPathElement>('[data-icon-meniu] path');
    if (icon) icon.setAttribute('d', 'M3 6h14M3 10h14M3 14h14');
    document.body.style.overflow = '';
  };
  panou?.querySelectorAll('a').forEach((a) => a.addEventListener('click', inchideMeniu));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') inchideMeniu(); });

  const cauta = document.querySelector<HTMLButtonElement>('[data-cauta-comuta]');
  const panouCauta = document.getElementById('panou-cautare');
  cauta?.addEventListener('click', () => {
    const deschis = cauta.getAttribute('aria-expanded') === 'true';
    cauta.setAttribute('aria-expanded', String(!deschis));
    if (panouCauta) {
      panouCauta.hidden = deschis;
      if (!deschis) panouCauta.querySelector('input')?.focus();
    }
  });

  // Mega-meniu.
  // Panourile sunt copii ai barei de navigație, deci mutarea cursorului de pe
  // link în panou nu iese din `nav`. Închiderea se face doar la ieșirea din
  // toată bara, cu o mică întârziere, ca mișcarea în diagonală să nu o taie.
  // Linkurile DIN panou nu au voie să închidă: ele nu sunt în rândul de sus.
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const randNav = nav?.querySelector<HTMLElement>('[data-rand-nav]');
  if (nav && randNav) {
    const panouri = new Map<string, HTMLElement>();
    for (const el of nav.querySelectorAll<HTMLElement>('[data-panou]')) {
      panouri.set(el.dataset.panou!, el);
    }
    let ceas: number | undefined;
    const arata = (slug: string | null) => {
      window.clearTimeout(ceas);
      for (const [s, el] of panouri) el.dataset.deschis = s === slug ? 'da' : 'nu';
    };
    const inchideCuIntarziere = () => {
      window.clearTimeout(ceas);
      ceas = window.setTimeout(() => arata(null), 140);
    };

    for (const link of randNav.querySelectorAll<HTMLElement>('[data-mega]')) {
      const slug = link.dataset.mega!;
      link.addEventListener('mouseenter', () => arata(slug));
      link.addEventListener('focus', () => arata(slug));
    }
    // doar linkurile din rândul de sus închid, nu si cele din panou
    for (const link of randNav.querySelectorAll<HTMLElement>('a:not([data-mega])')) {
      link.addEventListener('mouseenter', () => arata(null));
      link.addEventListener('focus', () => arata(null));
    }

    nav.addEventListener('mouseleave', inchideCuIntarziere);
    nav.addEventListener('mouseenter', () => window.clearTimeout(ceas));
    nav.addEventListener('focusout', (e) => {
      if (!nav.contains(e.relatedTarget as Node)) arata(null);
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') arata(null); });
    arata(null);
  }

  // Header-ul e înalt la început și se strânge la derulare, ca să nu mănânce ecranul.
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const laDerulare = () => {
      header.dataset.strans = window.scrollY > 80 ? 'da' : 'nu';
    };
    laDerulare();
    window.addEventListener('scroll', laDerulare, { passive: true });
  }
</script>
