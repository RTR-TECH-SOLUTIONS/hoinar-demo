---
import { Image } from 'astro:assets';
import { getImagine } from '../lib/imagini';
import { formatPret } from '../lib/pret';
import { url } from '../lib/i18n';
import Stele from './Stele.astro';
import type { Produs } from '../lib/catalog';
import type { Limba } from '../lib/pret';

interface Props { produs: Produs; lang: Limba; prioritar?: boolean }
const { produs, lang, prioritar = false } = Astro.props;
const ro = lang === 'ro';
const href = url(lang, `/produs/${produs.slug}`);
const principala = getImagine(produs.imagini[0]);
const secundara = produs.imagini[1] ? getImagine(produs.imagini[1]) : null;
const stocRedus = produs.stoc > 0 && produs.stoc <= 6;
const areReducere = produs.reducere > 0 && produs.pretVechiRon;
---

<article class="group">
  <a href={href} class="block">
    <div class="relative overflow-hidden rounded-[10px] bg-nisip">
      <Image
        src={principala}
        alt={produs.nume}
        widths={[320, 480, 720]}
        sizes="(min-width: 1024px) 22vw, (min-width: 640px) 45vw, 90vw"
        loading={prioritar ? 'eager' : 'lazy'}
        class="aspect-[3/4] w-full object-cover transition-opacity duration-300 ease-out group-hover:opacity-0"
      />
      {secundara && (
        <Image
          src={secundara}
          alt=""
          widths={[320, 480, 720]}
          sizes="(min-width: 1024px) 22vw, (min-width: 640px) 45vw, 90vw"
          loading="lazy"
          class="absolute inset-0 aspect-[3/4] w-full object-cover opacity-0 transition-opacity duration-300 ease-out group-hover:opacity-100"
        />
      )}

      <div class="pointer-events-none absolute inset-x-2.5 top-2.5 flex items-start justify-between gap-2">
        <div class="flex flex-col items-start gap-1.5">
          {areReducere && (
            <span class="rounded-[6px] bg-teracota px-2 py-1 text-[0.72rem] font-medium leading-none text-crem tabular-nums">
              −{produs.reducere}%
            </span>
          )}
          {produs.esteSet && (
            <span class="rounded-[6px] bg-ink px-2 py-1 text-[0.72rem] leading-none text-crem">
              {ro ? 'Set' : 'Set'}
            </span>
          )}
          {produs.nou && !areReducere && (
            <span class="rounded-[6px] bg-ciocolata px-2 py-1 text-[0.72rem] leading-none text-crem">
              {ro ? 'Nou' : 'New'}
            </span>
          )}
        </div>
        {stocRedus && (
          <span class="rounded-[6px] bg-crem/95 px-2 py-1 text-[0.72rem] leading-none text-teracota tabular-nums">
            {ro ? `Ultimele ${produs.stoc}` : `Only ${produs.stoc}`}
          </span>
        )}
      </div>
    </div>

    <div class="mt-3">
      <Stele n={produs.rating} nr={produs.nrRecenzii} marime={11} />
      <h3 class="mt-1.5 font-[family-name:var(--font-sans)] text-[0.92rem] font-normal leading-snug">
        {produs.nume}
      </h3>
      <p class="mt-1 flex flex-wrap items-baseline gap-2 text-[0.92rem] tabular-nums">
        <span class={areReducere ? 'font-medium text-teracota' : 'text-ciocolata'}>
          {formatPret(produs.pretRon)}
        </span>
        {produs.pretVechiRon && (
          <span class="text-[0.82rem] text-ciocolata/45 line-through">
            {formatPret(produs.pretVechiRon)}
          </span>
        )}
      </p>
    </div>
  </a>
</article>
