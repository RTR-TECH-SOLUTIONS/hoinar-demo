---
import { Image } from 'astro:assets';
import { getImagine } from '../lib/imagini';
import { formatPret } from '../lib/pret';
import { url } from '../lib/i18n';
import type { Produs } from '../lib/catalog';
import type { Limba } from '../lib/pret';

interface Props { produs: Produs; lang: Limba; prioritar?: boolean }
const { produs, lang, prioritar = false } = Astro.props;
const href = url(lang, `/produs/${produs.slug}`);
const principala = getImagine(produs.imagini[0]);
const secundara = produs.imagini[1] ? getImagine(produs.imagini[1]) : null;
const stocRedus = produs.stoc > 0 && produs.stoc <= 6;
---

<article class="group">
  <a href={href} class="block">
    <div class="relative overflow-hidden rounded-[10px] bg-nisip">
      <Image
        src={principala}
        alt={produs.nume}
        widths={[320, 480, 720]}
        sizes="(min-width: 1024px) 22vw, (min-width: 640px) 45vw, 90vw"
        loading={prioritar ? 'eager' : 'lazy'}
        class="aspect-[3/4] w-full object-cover transition-opacity duration-300 ease-out group-hover:opacity-0"
      />
      {secundara && (
        <Image
          src={secundara}
          alt=""
          widths={[320, 480, 720]}
          sizes="(min-width: 1024px) 22vw, (min-width: 640px) 45vw, 90vw"
          loading="lazy"
          class="absolute inset-0 aspect-[3/4] w-full object-cover opacity-0 transition-opacity duration-300 ease-out group-hover:opacity-100"
        />
      )}
      {produs.esteSet && (
        <span class="absolute left-3 top-3 rounded-[6px] bg-ink px-2.5 py-1 text-[0.68rem] text-crem">
          {lang === 'ro' ? `Economisești ${produs.economieRon} lei` : `Save ${produs.economieRon} lei`}
        </span>
      )}
      {stocRedus && !produs.esteSet && (
        <span class="absolute left-3 top-3 rounded-[6px] bg-crem/92 px-2.5 py-1 text-[0.68rem] text-teracota">
          {lang === 'ro' ? `Ultimele ${produs.stoc}` : `Only ${produs.stoc} left`}
        </span>
      )}
    </div>

    <div class="mt-3">
      <h3 class="font-[family-name:var(--font-sans)] text-[0.92rem] font-normal leading-snug">
        {produs.nume}
      </h3>
      <p class="mt-1 text-[0.88rem] tabular-nums text-ciocolata/80">
        {formatPret(produs.pretRon)}
        {produs.pretIntregRon && (
          <span class="ml-2 text-ciocolata/45 line-through">{formatPret(produs.pretIntregRon)}</span>
        )}
      </p>
    </div>
  </a>
</article>
