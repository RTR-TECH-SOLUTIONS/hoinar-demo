---
import type { Limba } from '../lib/pret';
interface Props { lang: Limba }
const { lang } = Astro.props;
const ro = lang === 'ro';

/** Banda închisă de sub header. La referință aici stă nota Trustpilot;
 *  noi alternăm nota cu mesajele comerciale. */
const mesaje = ro
  ? [
      { tip: 'nota' as const, text: 'Excelent · 4,8 din 5 · 1.284 de recenzii' },
      { tip: 'oferta' as const, text: 'Reduceri până la −30% la colecția de toamnă', href: '/reduceri' },
      { tip: 'simplu' as const, text: 'Transport gratuit peste 250 de lei · Retur în 14 zile', href: '/livrare-retur' },
      { tip: 'simplu' as const, text: 'Livrare în 24-48 de ore · Plata ramburs disponibilă', href: '/livrare-retur' },
    ]
  : [
      { tip: 'nota' as const, text: 'Excellent · 4.8 out of 5 · 1,284 reviews' },
      { tip: 'oferta' as const, text: 'Up to −30% off the autumn collection', href: '/en/reduceri' },
      { tip: 'simplu' as const, text: 'Free shipping over 250 lei · 14-day returns', href: '/en/livrare-retur' },
      { tip: 'simplu' as const, text: 'Delivered in 24-48 hours · Cash on delivery available', href: '/en/livrare-retur' },
    ];
---

<div class="bg-ink text-crem">
  <div class="container-brand relative flex h-[var(--bara-h)] items-center justify-center overflow-hidden" data-promo>
    {mesaje.map((m, i) => (
      <a
        href={m.tip === 'nota' ? (ro ? '/poveste' : '/en/poveste') : m.href}
        data-promo-mesaj
        data-activ={i === 0 ? 'da' : 'nu'}
        class="absolute inset-0 flex items-center justify-center gap-2.5 text-center text-[0.76rem] opacity-0 transition-opacity duration-500 data-[activ=da]:opacity-100"
      >
        {m.tip === 'nota' && (
          <span class="flex items-center gap-[2px]" aria-hidden="true">
            {[0, 1, 2, 3, 4].map(() => (
              <svg width="11" height="11" viewBox="0 0 12 12" class="fill-camel">
                <path d="M6 0.6l1.6 3.4 3.7.5-2.7 2.6.7 3.7L6 9.05 2.7 10.8l.7-3.7L.7 4.5l3.7-.5z" />
              </svg>
            ))}
          </span>
        )}
        {m.tip === 'oferta' && (
          <span class="rounded-[4px] bg-teracota px-1.5 py-0.5 text-[0.68rem] leading-none">
            {ro ? 'Ofertă' : 'Sale'}
          </span>
        )}
        <span class="truncate">{m.text}</span>
      </a>
    ))}
  </div>
</div>

<script>
  const mesaje = document.querySelectorAll<HTMLElement>('[data-promo-mesaj]');
  if (mesaje.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let i = 0;
    setInterval(() => {
      mesaje[i].dataset.activ = 'nu';
      i = (i + 1) % mesaje.length;
      mesaje[i].dataset.activ = 'da';
    }, 4200);
  }
</script>
