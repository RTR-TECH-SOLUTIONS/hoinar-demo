---
import { getImage } from 'astro:assets';
import { getImagine } from '../../lib/imagini';
import { getProdus, getColectie, getComponenteSet, type Produs } from '../../lib/catalog';
import { traduceri, url } from '../../lib/i18n';
import { formatPret } from '../../lib/pret';
import type { Limba } from '../../lib/pret';
import AdaugaInCos from '../AdaugaInCos.tsx';
import InimaProdus from '../InimaProdus.tsx';
import Galerie from '../Galerie.tsx';
import ConstructorSet from '../ConstructorSet.tsx';
import CardProdus from '../CardProdus.astro';
import Stele from '../Stele.astro';

interface Props { produs: Produs; lang: Limba }
const { produs, lang } = Astro.props;
const t = traduceri(lang);
const u = (c: string) => url(lang, c);

const colectie = await getColectie(produs.colectie, lang);
const piese = await getComponenteSet(produs.colectie, lang);
const inrudite = piese.filter((p) => p.slug !== produs.slug).slice(0, 4);

/** Insulele React primesc URL-uri gata optimizate, nu ImageMetadata. */
async function src(cale: string, w: number) {
  return (await getImage({ src: getImagine(cale), width: w, format: 'webp' })).src;
}
const imagineCos = await src(produs.imagini[0], 200);

const imaginiGalerie = await Promise.all(
  produs.imagini.map(async (cale) => ({
    mic: await src(cale, 160),
    mare: await src(cale, 1000),
  })),
);

const pieseSet = await Promise.all(
  piese.map(async (p) => ({
    slug: p.slug,
    nume: p.nume,
    tipNume: p.tipNume,
    pretRon: p.pretRon,
    pretVechiRon: p.pretVechiRon,
    imagine: await src(p.imagini[0], 420),
    url: u(`/produs/${p.slug}`),
    marimi: p.marimi,
  })),
);

const stocRedus = produs.stoc > 0 && produs.stoc <= 6;

const areReducere = produs.reducere > 0 && produs.pretVechiRon;
const acordeoane = [
  { titlu: t('produs.caracteristici'), continut: produs.caracteristici },
  { titlu: t('produs.livrare'), text: t('produs.livrareText') },
];
const intrebari = [
  [t('produs.intrebare1'), t('produs.raspuns1')],
  [t('produs.intrebare2'), t('produs.raspuns2')],
  [t('produs.intrebare3'), t('produs.raspuns3')],
];
---

<div class="container-brand pt-6">
  <nav aria-label="breadcrumb" class="text-[0.8rem] text-ciocolata/60">
    <a href={u('/')} class="hover:text-teracota">{t('produs.acasa')}</a>
    <span aria-hidden="true" class="mx-2">/</span>
    <a href={u(`/colectie/${produs.colectie}`)} class="hover:text-teracota">{colectie?.nume}</a>
    <span aria-hidden="true" class="mx-2">/</span>
    <span class="text-ciocolata/85">{produs.tipNume}</span>
  </nav>
</div>

<article class="container-brand mt-6 grid gap-10 lg:grid-cols-[minmax(0,0.92fr)_minmax(0,1fr)] lg:gap-14">
  <!-- GALERIE: imagine principală plus miniaturi, nu un teanc de poze uriașe -->
  <div class="mx-auto w-full max-w-[32rem] lg:mx-0 lg:max-w-none">
    <Galerie
      client:load
      imagini={imaginiGalerie}
      alt={produs.nume}
      eticheta={lang === 'ro' ? 'Alte imagini' : 'More images'}
    />
  </div>

  <!-- INFORMAȚII -->
  <div class="lg:sticky lg:top-[calc(var(--header-total)+1.5rem)] lg:self-start">
    <a href={u(`/colectie/${produs.colectie}`)} class="text-[0.78rem] uppercase tracking-[0.12em] text-teracota">
      {colectie?.nume}
    </a>

    <h1 class="mt-2.5 text-[1.75rem] leading-tight md:text-[2rem]">{produs.tipNume}</h1>

    <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
      <p class="flex items-baseline gap-2.5">
        <span class={`text-[1.3rem] tabular-nums ${areReducere ? 'text-teracota' : ''}`}>
          {formatPret(produs.pretRon)}
        </span>
        {produs.pretVechiRon && (
          <span class="text-[0.95rem] tabular-nums text-ciocolata/45 line-through">
            {formatPret(produs.pretVechiRon)}
          </span>
        )}
        {areReducere && (
          <span class="rounded-[5px] bg-teracota px-1.5 py-0.5 text-[0.72rem] leading-none text-crem tabular-nums">
            −{produs.reducere}%
          </span>
        )}
      </p>
      <div class="flex items-center gap-1.5">
        <Stele n={produs.rating} marime={13} />
        <span class="text-[0.8rem] tabular-nums text-ciocolata/55">
          {produs.rating.toFixed(1)} · {produs.nrRecenzii} {lang === 'ro' ? 'recenzii' : 'reviews'}
        </span>
      </div>
    </div>

    <p class="mt-3 flex items-center gap-2 text-[0.85rem]">
      <span
        aria-hidden="true"
        class={`inline-block h-[0.5rem] w-[0.5rem] rounded-full ${
          produs.stoc === 0 ? 'bg-ciocolata/30' : stocRedus ? 'bg-teracota' : 'bg-[#5c7a4a]'
        }`}
      ></span>
      {produs.stoc === 0
        ? <span class="text-ciocolata/55">{t('produs.epuizat')}</span>
        : stocRedus
          ? <span class="text-teracota">{t('produs.stocRedus')} — {produs.stoc} {lang === 'ro' ? 'bucăți' : 'left'}</span>
          : <span class="text-ciocolata/70">{t('produs.stoc')}</span>}
    </p>

    <!-- trei argumente scurte, deasupra mărimilor, ca la referință -->
    <ul class="mt-5 space-y-2.5 border-y border-linie py-5">
      {produs.caracteristici.slice(0, 3).map((c) => (
        <li class="flex items-start gap-2.5 text-[0.9rem] leading-snug">
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" class="mt-[0.15em] shrink-0 fill-none stroke-teracota" stroke-width="1.5">
            <circle cx="8" cy="8" r="6.6" />
            <path d="M5.2 8.2l2 2 3.6-4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span class="text-ciocolata/85">{c}</span>
        </li>
      ))}
    </ul>

    <AdaugaInCos
      client:load
      slug={produs.slug}
      nume={produs.nume}
      pretRon={produs.pretRon}
      imagine={imagineCos}
      url={u(`/produs/${produs.slug}`)}
      marimi={produs.marimi}
      stoc={produs.stoc}
      t={{
        marime: t('produs.marime'),
        adauga: t('actiune.adauga'),
        epuizat: t('produs.epuizat'),
        alegeMarime: t('produs.alegeMarime'),
      }}
    />

    <div class="mt-3 flex items-center justify-between gap-4">
      <InimaProdus client:idle slug={produs.slug} adauga={t('favorite.adauga')} adaugat={t('favorite.adaugat')} />
      <a href={u('/ghid-marimi')} class="mt-3 text-[0.85rem] underline underline-offset-4 hover:text-teracota">
        {t('produs.ghid')}
      </a>
    </div>

    <div class="mt-8 border-t border-linie">
      <details class="group border-b border-linie" open>
        <summary class="flex cursor-pointer list-none items-center justify-between py-4 text-[0.95rem] marker:content-none">
          {t('produs.descriere')}
          <span aria-hidden="true" class="text-[1.1rem] leading-none text-ciocolata/50 transition-transform duration-200 group-open:rotate-45">+</span>
        </summary>
        <p class="max-w-[54ch] pb-5 text-[0.9rem] leading-relaxed text-ciocolata/80">{produs.descriere}</p>
      </details>

      {acordeoane.map((a) => (
        <details class="group border-b border-linie">
          <summary class="flex cursor-pointer list-none items-center justify-between py-4 text-[0.95rem] marker:content-none">
            {a.titlu}
            <span aria-hidden="true" class="text-[1.1rem] leading-none text-ciocolata/50 transition-transform duration-200 group-open:rotate-45">+</span>
          </summary>
          <div class="pb-5 text-[0.9rem] leading-relaxed text-ciocolata/80">
            {a.continut
              ? <ul class="space-y-2">{a.continut.map((c) => (
                  <li class="flex gap-2.5">
                    <span aria-hidden="true" class="mt-[0.6em] h-[3px] w-[10px] shrink-0 bg-camel"></span>
                    <span>{c}</span>
                  </li>
                ))}</ul>
              : <p class="max-w-[54ch]">{a.text}</p>}
          </div>
        </details>
      ))}

      <details class="group border-b border-linie">
        <summary class="flex cursor-pointer list-none items-center justify-between py-4 text-[0.95rem] marker:content-none">
          {t('produs.intrebari')}
          <span aria-hidden="true" class="text-[1.1rem] leading-none text-ciocolata/50 transition-transform duration-200 group-open:rotate-45">+</span>
        </summary>
        <div class="space-y-4 pb-5">
          {intrebari.map(([q, a]) => (
            <div>
              <p class="text-[0.9rem]">{q}</p>
              <p class="mt-1 max-w-[54ch] text-[0.88rem] leading-relaxed text-ciocolata/75">{a}</p>
            </div>
          ))}
        </div>
      </details>
    </div>
  </div>
</article>

{!produs.esteSet && pieseSet.length > 1 && (
  <section class="mt-[var(--sectiune-strans)] border-y border-linie bg-nisip">
    <div class="container-brand py-[var(--sectiune-strans)]">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 style="font-size: var(--pas-2xl)">{t('produs.set')}</h2>
          <p class="mt-2 max-w-[56ch] text-[0.93rem] leading-relaxed text-ciocolata/75">
            {t('produs.setText')}
          </p>
        </div>
        <a href={u(`/colectie/${produs.colectie}`)} class="shrink-0 text-[0.88rem] underline underline-offset-4 hover:text-teracota">
          {colectie?.nume}
        </a>
      </div>

      <div class="mt-8">
        <ConstructorSet
          client:visible
          piese={pieseSet}
          presel={[produs.slug]}
          t={{
            total: t('produs.total'),
            economie: t('produs.economie'),
            indiciu: t('produs.indiciu'),
            adauga: t('produs.adaugaSet'),
            marime: t('produs.marime'),
            piesa: t('produs.piesa'),
            piese: t('produs.piese'),
            nota: t('produs.setNota'),
            adauga1: t('produs.setAdauga1'),
            adaugat: t('produs.setAdaugat'),
            sumar: t('produs.setSumar'),
            niciuna: t('produs.setNiciuna'),
            inca: t('produs.setInca'),
          }}
        />
      </div>
    </div>
  </section>
)}

{inrudite.length > 0 && (
  <section class="container-brand mt-[var(--sectiune)]">
    <h2 style="font-size: var(--pas-xl)">{t('produs.dinColectie')}</h2>
    <div class="mt-7 grid grid-cols-2 gap-x-4 gap-y-9 lg:grid-cols-4">
      {inrudite.map((p) => <CardProdus produs={p} lang={lang} />)}
    </div>
  </section>
)}
