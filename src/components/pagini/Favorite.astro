---
import { getImage } from 'astro:assets';
import { getImagine } from '../../lib/imagini';
import { getProduse, getBestsellers } from '../../lib/catalog';
import { traduceri, url } from '../../lib/i18n';
import type { Limba } from '../../lib/pret';
import ListaFavorite from '../ListaFavorite.tsx';

interface Props { lang: Limba }
const { lang } = Astro.props;
const t = traduceri(lang);
const u = (c: string) => url(lang, c);

async function src(cale: string, w: number) {
  return (await getImage({ src: getImagine(cale), width: w, format: 'webp' })).src;
}

async function laItem(p: any) {
  return {
    slug: p.slug,
    nume: p.nume,
    tipNume: p.tipNume,
    pretRon: p.pretRon,
    pretVechiRon: p.pretVechiRon,
    reducere: p.reducere,
    marimi: p.marimi,
    img: await src(p.imagini[0], 620),
    imgCos: await src(p.imagini[0], 200),
    url: u(`/produs/${p.slug}`),
  };
}

const toate = await Promise.all((await getProduse(lang, {})).map(laItem));
const sugestii = await Promise.all((await getBestsellers(lang, 4)).map(laItem));

const tc = {
  gol: t('favorite.gol'),
  golText: t('favorite.golText'),
  numarate: t('favorite.numarate'),
  sugestii: t('favorite.sugestii'),
  toateInCos: t('favorite.toateInCos'),
  economie: t('favorite.economie'),
  sterge: t('actiune.sterge'),
  adauga: t('favorite.cumpara'),
  adaugat: t('favorite.cumparat'),
  marime: t('produs.marime'),
};
---
<div class="container-brand py-12">
  <h1 style="font-size: var(--pas-2xl)">{t('favorite.titlu')}</h1>
  <div class="mt-8">
    <ListaFavorite
      client:load
      toate={toate}
      sugestii={sugestii}
      imagineGol={await src('/media/pui/fav-gol.jpg', 900)}
      t={tc}
    />
  </div>
</div>
