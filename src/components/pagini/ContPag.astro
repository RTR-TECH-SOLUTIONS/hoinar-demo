---
import { Image } from 'astro:assets';
import { getImagine } from '../../lib/imagini';
import { traduceri } from '../../lib/i18n';
import type { Limba } from '../../lib/pret';
import Cont from '../Cont.tsx';

interface Props { lang: Limba }
const { lang } = Astro.props;
const t = traduceri(lang);
const ro = lang === 'ro';
const chei = ['intra','nou','email','parola','nume','uitat','intraButon','creeaza','termeni','demo','gata'] as const;
const tc: Record<string, string> = Object.fromEntries(chei.map((c) => [c, t(`cont.${c}` as any)]));
const avantaje = [t('cont.deCe1'), t('cont.deCe2'), t('cont.deCe3'), t('cont.deCe4')];

const garantii = ro
  ? [
      ['Livrare în 24-48 h', 'Sameday easybox, FAN sau Cargus'],
      ['Retur în 14 zile', 'Primul schimb de mărime e gratuit'],
      ['Plata ramburs', 'Sau cu cardul, online'],
      ['Datele tale rămân ale tale', 'Nu le vindem și nu le dăm nimănui'],
    ]
  : [
      ['Delivered in 24-48 h', 'Sameday locker, FAN or Cargus'],
      ['14-day returns', 'First size exchange is free'],
      ['Cash on delivery', 'Or pay by card, online'],
      ['Your data stays yours', 'We do not sell it or pass it on'],
    ];
---

<div class="container-brand py-10 lg:py-14">
  <div class="grid gap-10 lg:grid-cols-[1fr_1fr] lg:items-stretch lg:gap-16">
    <!-- panoul cu imagine -->
    <div class="apare relative isolate overflow-hidden rounded-[14px] bg-ciocolata">
      <Image
        src={getImagine('/media/pui/cont.jpg')}
        alt=""
        widths={[520, 900]}
        sizes="(min-width: 1024px) 44vw, 92vw"
        loading="eager"
        class="h-full min-h-[22rem] w-full object-cover object-[center_28%] lg:min-h-[34rem]"
      />
      <span
        class="pointer-events-none absolute inset-0"
        style="background: linear-gradient(to top, rgba(24,22,19,0.86) 0%, rgba(24,22,19,0.45) 38%, rgba(24,22,19,0.05) 72%, transparent 100%);"
        aria-hidden="true"></span>

      <div class="absolute inset-x-0 bottom-0 p-6 lg:p-8">
        <h2 class="text-crem" style="font-size: var(--pas-xl)">{t('cont.deCe')}</h2>
        <ul class="mt-4 space-y-2.5">
          {avantaje.map((a, i) => (
            <li
              class="apare-x flex items-start gap-2.5 text-[0.88rem] leading-snug text-crem/85"
              style={`--pas: ${180 + i * 90}ms`}
            >
              <span aria-hidden="true" class="mt-[0.55em] h-[3px] w-[11px] shrink-0 bg-camel"></span>
              {a}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- formularul -->
    <div class="flex flex-col justify-center">
      <h1 style="font-size: var(--pas-2xl)">{t('cont.titlu')}</h1>
      <p class="mt-2.5 max-w-[44ch] text-[0.93rem] leading-relaxed text-ciocolata/70">
        {ro
          ? 'Intri o dată și îți ții comenzile, adresa și favoritele la un loc. Durează un minut.'
          : 'Sign in once and keep your orders, address and saved pieces together. It takes a minute.'}
      </p>
      <div class="mt-8">
        <Cont client:load t={tc} />
      </div>
    </div>
  </div>

  <!-- garanții, sub formular -->
  <ul class="mt-[var(--sectiune-strans)] grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {garantii.map(([titlu, text], i) => (
      <li
        data-apare
        style={`--pas: ${i * 90}ms`}
        class="rounded-[12px] border border-linie bg-nisip p-5 transition-colors duration-200 hover:border-camel"
      >
        <span aria-hidden="true" class="block h-[3px] w-[18px] bg-teracota"></span>
        <p class="mt-3 text-[0.95rem]">{titlu}</p>
        <p class="mt-1 text-[0.85rem] leading-snug text-ciocolata/65">{text}</p>
      </li>
    ))}
  </ul>

  <!-- o vorbă de la un client, ca pagina să nu fie doar formular -->
  <figure data-apare class="mt-[var(--sectiune-strans)] rounded-[14px] border border-linie px-6 py-10 text-center sm:px-12">
    <blockquote class="mx-auto max-w-[52ch] font-[family-name:var(--font-serif)] text-[1.35rem] leading-snug sm:text-[1.6rem]">
      {ro
        ? '„Am comandat marți seara, joi dimineața era la easybox. A doua oară n-a mai trebuit să scriu nimic, adresa era deja acolo."'
        : '“Ordered Tuesday evening, it was in the locker by Thursday morning. The second time I typed nothing, the address was already there.”'}
    </blockquote>
    <figcaption class="mt-5 text-[0.85rem] text-ciocolata/60">
      {ro ? 'Ioana T., Timișoara' : 'Ioana T., Timisoara'}
    </figcaption>
  </figure>
</div>
