---
import { Image } from 'astro:assets';
import { getImagine } from '../../lib/imagini';
import { getBestsellers, getColectii, getTipuri, getProduse } from '../../lib/catalog';
import { traduceri, url } from '../../lib/i18n';
import type { Limba } from '../../lib/pret';
import CardProdus from '../CardProdus.astro';
import Stele from '../Stele.astro';
import recenziiBrute from '../../data/recenzii.json';

interface Props { lang: Limba }
const { lang } = Astro.props;
const t = traduceri(lang);
const u = (c: string) => url(lang, c);

const bestsellers = await getBestsellers(lang, 4);
const colectii = await getColectii(lang);
const tipuri = await getTipuri(lang);
const talieMare = (await getProduse(lang, { segment: 'talie-mare' })).slice(0, 1)[0];

const recenzii = recenziiBrute.map((r) => ({
  ...r,
  oras: r.oras[lang],
  text: r.text[lang],
}));

const heroPoster = getImagine('/media/hero/hero-poster.jpg');
const macroPoster = getImagine('/media/hero/macro-poster.jpg');
---

<!-- HERO -->
<section class="relative isolate overflow-hidden bg-ciocolata">
  <video
    class="absolute inset-0 h-full w-full object-cover motion-reduce:hidden"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster={heroPoster.src}
    aria-hidden="true"
  >
    <source src="/media/video/hero.webm" type="video/webm" />
    <source src="/media/video/hero.mp4" type="video/mp4" />
  </video>
  <Image
    src={heroPoster}
    alt=""
    widths={[900, 1400, 1600]}
    sizes="100vw"
    loading="eager"
    class="absolute inset-0 hidden h-full w-full object-cover motion-reduce:block"
  />

  <div class="pointer-events-none absolute inset-0 bg-ink/30" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute inset-0"
    style="background: linear-gradient(to top, rgba(24,22,19,0.82) 0%, rgba(24,22,19,0.72) 34%, rgba(24,22,19,0.40) 62%, rgba(24,22,19,0.10) 86%, transparent 100%);"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-0 hidden md:block"
    style="background: linear-gradient(to right, rgba(24,22,19,0.40) 0%, rgba(24,22,19,0.14) 42%, transparent 68%);"
    aria-hidden="true"
  >
  </div>

  <div class="container-brand relative flex min-h-[clamp(32rem,82svh,48rem)] flex-col justify-end pb-16 pt-28">
    <h1 class="max-w-[15ch] text-crem" style="font-size: var(--pas-3xl)">
      {t('hero.titlu')}
    </h1>
    <p class="mt-5 max-w-[46ch] text-[1.02rem] leading-relaxed text-crem">
      {t('hero.text')}
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={u('/colectii')}
        class="rounded-[10px] bg-crem px-7 py-3.5 text-[0.92rem] text-ink transition-colors hover:bg-nisip"
      >{t('hero.cta')}</a>
      <a
        href={u('/categorie/ham')}
        class="rounded-[10px] border border-crem/55 bg-ink/50 px-7 py-3.5 text-[0.92rem] text-crem backdrop-blur-[2px] transition-colors hover:border-crem hover:bg-ink/70"
      >{t('hero.cta2')}</a>
    </div>
  </div>
</section>

<!-- CATEGORII -->
<section class="container-brand sectiune">
  <h2 style="font-size: var(--pas-2xl)">{t('sec.categorii')}</h2>
  <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
    {tipuri.map((tip) => (
      <a href={u(`/categorie/${tip.slug}`)} class="group relative block overflow-hidden rounded-[10px] bg-nisip">
        <Image
          src={getImagine(tip.imagine)}
          alt=""
          widths={[300, 500]}
          sizes="(min-width: 1024px) 24vw, (min-width: 640px) 32vw, 48vw"
          loading="lazy"
          class="aspect-[4/5] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
        />
        <span
          class="pointer-events-none absolute inset-x-0 bottom-0 h-1/2"
          style="background: linear-gradient(to top, rgba(24,22,19,0.65), transparent);"
          aria-hidden="true"
        ></span>
        <span class="absolute bottom-3 left-3.5 right-3 text-[0.9rem] text-crem">{tip.nume}</span>
      </a>
    ))}
  </div>
</section>

<!-- BESTSELLERS -->
<section class="container-brand sectiune pt-0">
  <div class="flex items-end justify-between gap-6">
    <h2 style="font-size: var(--pas-2xl)">{t('sec.bestsellers')}</h2>
    <a href={u('/colectii')} class="shrink-0 text-[0.88rem] underline underline-offset-4 hover:text-teracota">
      {t('nav.toate')}
    </a>
  </div>
  <div class="mt-8 grid grid-cols-2 gap-x-4 gap-y-9 lg:grid-cols-4">
    {bestsellers.map((p) => <CardProdus produs={p} lang={lang} />)}
  </div>
</section>

<!-- EDITORIAL -->
<section class="bg-nisip">
  <div class="container-brand sectiune grid items-center gap-10 md:grid-cols-[1.15fr_0.85fr] md:gap-16">
    <div class="order-2 md:order-1">
      <h2 style="font-size: var(--pas-3xl)">
        {lang === 'ro' ? 'Testat la 187 de kilograme' : 'Pull-tested to 187 kilograms'}
      </h2>
      <p class="mt-5 max-w-[48ch] leading-relaxed text-ciocolata/80">
        {lang === 'ro'
          ? 'Fiecare chingă trece printr-un test de tracțiune înainte să iasă din atelier. Nu pentru că un câine trage atât, ci pentru că lesa se agață în portbagaj, în ușă, în gard. Cusătura în X pe patru rânduri e acolo pentru momentul ăla.'
          : 'Every strap goes through a pull test before it leaves the workshop. Not because a dog pulls that hard, but because leads catch on boot lids, doors and fences. The four-row cross stitch is there for that moment.'}
      </p>
      <ul class="mt-7 space-y-3 text-[0.92rem]">
        {[
          lang === 'ro' ? 'Cusătură în X pe patru rânduri, la fiecare punct de prindere' : 'Four-row cross stitch at every load point',
          lang === 'ro' ? 'Catarame din alamă, nu din zamac vopsit' : 'Brass buckles, not painted zinc alloy',
          lang === 'ro' ? 'Inele D sudate, nu doar îndoite' : 'Welded D-rings, not merely bent closed',
        ].map((linie) => (
          <li class="flex gap-3 border-b border-linie pb-3">
            <span aria-hidden="true" class="mt-[0.55em] h-[3px] w-[14px] shrink-0 bg-teracota"></span>
            <span class="text-ciocolata/85">{linie}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="order-1 mx-auto w-full max-w-[26rem] overflow-hidden rounded-[14px] bg-crem md:order-2 md:max-w-none">
      <video
        class="aspect-[4/5] max-h-[34rem] w-full object-cover motion-reduce:hidden"
        autoplay muted loop playsinline preload="none"
        poster={macroPoster.src}
        aria-hidden="true"
      >
        <source src="/media/video/macro.webm" type="video/webm" />
        <source src="/media/video/macro.mp4" type="video/mp4" />
      </video>
      <Image
        src={macroPoster}
        alt=""
        widths={[500, 820]}
        sizes="(min-width: 768px) 46vw, 92vw"
        loading="lazy"
        class="hidden aspect-[4/5] max-h-[34rem] w-full object-cover motion-reduce:block"
      />
    </div>
  </div>
</section>

<!-- COLECTII -->
<section class="sectiune">
  <div class="container-brand">
    <h2 style="font-size: var(--pas-2xl)">{t('sec.colectii')}</h2>
    <p class="mt-3 max-w-[52ch] text-ciocolata/75">{t('sec.colectiiSub')}</p>
  </div>
  <div class="mt-8 flex snap-x snap-mandatory gap-4 overflow-x-auto px-[clamp(1rem,0.5rem+2.5vw,3rem)] pb-3 [scrollbar-width:thin]">
    {colectii.map((c) => (
      <a
        href={u(`/colectie/${c.slug}`)}
        class="group w-[78vw] shrink-0 snap-start sm:w-[46vw] lg:w-[calc((90rem-6rem-3rem)/4)]"
      >
        <div class="overflow-hidden rounded-[10px] bg-nisip">
          <Image
            src={getImagine(c.imagine)}
            alt=""
            widths={[400, 700]}
            sizes="(min-width: 1024px) 22vw, (min-width: 640px) 46vw, 78vw"
            loading="lazy"
            class="aspect-[4/5] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
          />
        </div>
        <h3 class="mt-3.5 text-[1.15rem]">{c.nume}</h3>
        <p class="mt-1 text-[0.85rem] leading-relaxed text-ciocolata/70">{c.tesatura}</p>
      </a>
    ))}
  </div>
</section>

<!-- RECENZII -->
<section class="sectiune pt-0">
  <div class="container-brand">
    <h2 style="font-size: var(--pas-2xl)">{t('sec.recenzii')}</h2>
  </div>
  <div class="mt-8 flex snap-x snap-mandatory gap-4 overflow-x-auto px-[clamp(1rem,0.5rem+2.5vw,3rem)] pb-3 [scrollbar-width:thin]">
    {recenzii.map((r) => (
      <figure class="w-[80vw] shrink-0 snap-start overflow-hidden rounded-[10px] border border-linie bg-crem sm:w-[42vw] lg:w-[22rem]">
        <Image
          src={getImagine(r.imagine)}
          alt=""
          widths={[360, 700]}
          sizes="(min-width: 1024px) 22rem, (min-width: 640px) 42vw, 80vw"
          loading="lazy"
          class="aspect-[4/3] w-full object-cover"
        />
        <figcaption class="p-5">
          <Stele n={r.stele} />
          <blockquote class="mt-3 text-[0.92rem] leading-relaxed text-ciocolata/85">{r.text}</blockquote>
          <p class="mt-4 text-[0.8rem] text-ciocolata/60">{r.nume}, {r.oras}</p>
        </figcaption>
      </figure>
    ))}
  </div>
</section>

<!-- SEGMENTE -->
<section class="container-brand sectiune pt-0 grid gap-4 md:grid-cols-2">
  {[
    {
      titlu: lang === 'ro' ? 'Pentru câinii mari' : 'For the big dogs',
      text: lang === 'ro' ? 'Ham Explore, cu mâner de control și trei puncte de reglaj. Până la XXL.' : 'The Explore harness, with a control handle and three adjustment points. Up to XXL.',
      href: u('/categorie/ham-explore'),
      img: '/media/lifestyle/05.jpg',
    },
    {
      titlu: lang === 'ro' ? 'Pentru cățelușii mici' : 'For the small pups',
      text: lang === 'ro' ? 'Ham reglabil de la XS, cu chingă îngustă și cataramă ușoară.' : 'Adjustable harness from XS, with narrow webbing and a light buckle.',
      href: u('/categorie/ham'),
      img: '/media/lifestyle/13.jpg',
    },
  ].map((s) => (
    <a href={s.href} class="group relative block overflow-hidden rounded-[14px] bg-nisip">
      <Image
        src={getImagine(s.img)}
        alt=""
        widths={[600, 1000]}
        sizes="(min-width: 768px) 46vw, 92vw"
        loading="lazy"
        class="aspect-[3/2] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
      />
      <span
        class="pointer-events-none absolute inset-0"
        style="background: linear-gradient(to top, rgba(24,22,19,0.75), rgba(24,22,19,0.1) 55%, transparent);"
        aria-hidden="true"
      ></span>
      <span class="absolute inset-x-0 bottom-0 p-6">
        <span class="block font-[family-name:var(--font-serif)] text-[1.55rem] leading-tight text-crem">{s.titlu}</span>
        <span class="mt-1.5 block max-w-[38ch] text-[0.88rem] leading-relaxed text-crem/80">{s.text}</span>
      </span>
    </a>
  ))}
</section>

<!-- POVESTE -->
<section class="container-brand sectiune pt-0 grid items-center gap-10 md:grid-cols-[1fr_1.1fr] md:gap-16">
  <div class="overflow-hidden rounded-[14px] bg-nisip">
    <Image
      src={getImagine('/media/lifestyle/12.jpg')}
      alt=""
      widths={[500, 900]}
      sizes="(min-width: 768px) 44vw, 92vw"
      loading="lazy"
      class="aspect-[4/5] w-full object-cover"
    />
  </div>
  <div>
    <h2 style="font-size: var(--pas-2xl)">{t('sec.poveste')}</h2>
    <p class="mt-5 max-w-[52ch] leading-relaxed text-ciocolata/80">
      {lang === 'ro'
        ? 'A început dintr-o problemă banală: nu găseam un ham care să reziste unui an și să nu arate ca un echipament de vânătoare. Am comandat o rolă de chingă, am învățat să coasem, iar primele treizeci de hamuri le-am dat prietenilor din parc, ca să le rupă.'
        : 'It started with a dull problem: we could not find a harness that lasted a year and did not look like hunting kit. We ordered a roll of webbing, learned to sew, and gave the first thirty harnesses to friends from the park, so they could break them.'}
    </p>
    <p class="mt-4 max-w-[52ch] leading-relaxed text-ciocolata/80">
      {lang === 'ro'
        ? 'Le-au rupt. Am schimbat catarama, am dublat cusătura și am mai încercat o dată. Croim tot în București, în serii mici, din patru țesături pe care le ținem în stoc tot anul.'
        : 'They broke them. We changed the buckle, doubled the stitching and tried again. We still cut everything in Bucharest, in small runs, from four cloths we keep in stock all year.'}
    </p>
    <a href={u('/poveste')} class="mt-7 inline-block rounded-[10px] bg-ink px-7 py-3.5 text-[0.92rem] text-crem transition-colors hover:bg-ciocolata">
      {lang === 'ro' ? 'Cum sunt făcute' : 'How they are made'}
    </a>
  </div>
</section>

<!-- NEWSLETTER -->
<section class="bg-nisip">
  <div class="container-brand py-16 text-center">
    <h2 style="font-size: var(--pas-2xl)">{t('sec.newsletter')}</h2>
    <p class="mx-auto mt-3 max-w-[46ch] text-ciocolata/75">{t('sec.newsletterText')}</p>
    <form class="mx-auto mt-7 flex max-w-[30rem] flex-col gap-2.5 sm:flex-row" data-newsletter>
      <label class="sr-only" for="email-newsletter">{t('sec.email')}</label>
      <input
        id="email-newsletter"
        type="email"
        required
        placeholder={t('sec.email')}
        class="min-w-0 flex-1 rounded-[10px] border border-linie bg-crem px-4 py-3.5 text-[0.92rem] outline-none focus:border-teracota"
      />
      <button type="submit" class="rounded-[10px] bg-ink px-7 py-3.5 text-[0.92rem] text-crem transition-colors hover:bg-ciocolata">
        {t('sec.aboneaza')}
      </button>
    </form>
    <p class="mt-3 hidden text-[0.85rem] text-teracota" data-newsletter-ok>
      {lang === 'ro' ? 'Gata. Ne auzim luna viitoare.' : 'Done. We will write next month.'}
    </p>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-newsletter]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    form.hidden = true;
    document.querySelector<HTMLElement>('[data-newsletter-ok]')?.classList.remove('hidden');
  });
</script>
