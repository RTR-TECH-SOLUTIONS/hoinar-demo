---
import { Image } from 'astro:assets';
import { getImagine } from '../../lib/imagini';
import { getBestsellers, getColectii, getTipuri, getReduceri, getNoutati } from '../../lib/catalog';
import { traduceri, url } from '../../lib/i18n';
import { formatPret } from '../../lib/pret';
import type { Limba } from '../../lib/pret';
import CardProdus from '../CardProdus.astro';
import Stele from '../Stele.astro';
import Numaratoare from '../Numaratoare.tsx';
import recenziiBrute from '../../data/recenzii.json';

interface Props { lang: Limba }
const { lang } = Astro.props;
const t = traduceri(lang);
const ro = lang === 'ro';
const u = (c: string) => url(lang, c);

const bestsellers = await getBestsellers(lang, 4);
const colectii = await getColectii(lang);
const tipuri = await getTipuri(lang);
const reduceri = await getReduceri(lang, 4);
const noutati = await getNoutati(lang, 4);
const toateReducerile = await getReduceri(lang);

const recenzii = recenziiBrute.map((r) => ({ ...r, oras: r.oras[lang], text: r.text[lang] }));

const heroPoster = getImagine('/media/hero/hero-poster.jpg');
const alergarePoster = getImagine('/media/banner/alergare-poster.jpg');

/** Duminică seara, calculat la build. Dacă a trecut, sare la duminica următoare. */
const acum = new Date();
const finalOferta = new Date(acum);
finalOferta.setDate(acum.getDate() + ((7 - acum.getDay()) % 7));
finalOferta.setHours(23, 59, 59, 0);
if (finalOferta.getTime() <= acum.getTime()) finalOferta.setDate(finalOferta.getDate() + 7);

const reducereMax = Math.max(...toateReducerile.map((p) => p.reducere));

const trust = [
  [t('trust.livrare'), t('trust.livrareText')],
  [t('trust.transport'), t('trust.transportText')],
  [t('trust.retur'), t('trust.returText')],
  [t('trust.ramburs'), t('trust.rambursText')],
];

/** Șase categorii în bandă: opt nu încap fără să se înghesuie. */
const tipuriPrincipale = tipuri.filter((t) =>
  ['ham', 'ham-explore', 'lesa', 'zgarda', 'geanta', 'bandana'].includes(t.slug),
);

const ugc = ['/media/ugc/01.jpg', '/media/ugc/02.jpg', '/media/ugc/05.jpg', '/media/ugc/04.jpg', '/media/ugc/03.jpg'];
---

<!-- 1. HERO -->
<section class="relative isolate overflow-hidden bg-ciocolata">
  <video
    class="absolute inset-0 h-full w-full object-cover motion-reduce:hidden"
    autoplay muted loop playsinline preload="metadata"
    poster={heroPoster.src}
    aria-hidden="true"
  >
    <source src="/media/video/hero.webm" type="video/webm" />
    <source src="/media/video/hero.mp4" type="video/mp4" />
  </video>
  <Image
    src={heroPoster}
    alt=""
    widths={[900, 1400, 1600]}
    sizes="100vw"
    loading="eager"
    class="absolute inset-0 hidden h-full w-full object-cover motion-reduce:block"
  />

  <div class="pointer-events-none absolute inset-0 bg-ink/30" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute inset-0"
    style="background: linear-gradient(to top, rgba(24,22,19,0.82) 0%, rgba(24,22,19,0.72) 34%, rgba(24,22,19,0.40) 62%, rgba(24,22,19,0.10) 86%, transparent 100%);"
    aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute inset-0 hidden md:block"
    style="background: linear-gradient(to right, rgba(24,22,19,0.40) 0%, rgba(24,22,19,0.14) 42%, transparent 68%);"
    aria-hidden="true"></div>

  <div class="container-brand relative flex min-h-[clamp(30rem,78svh,45rem)] flex-col justify-end pb-14 pt-24">
    <a href={u('/reduceri')} class="w-fit rounded-[6px] bg-teracota px-3 py-1.5 text-[0.8rem] leading-none text-crem transition-opacity hover:opacity-90">
      {ro ? `Colecția de toamnă, până la −${reducereMax}%` : `Autumn collection, up to −${reducereMax}%`}
    </a>
    <h1 class="mt-5 max-w-[15ch] text-crem" style="font-size: var(--pas-3xl)">
      {ro ? 'Făcute pentru plimbarea de seară' : 'Made for the evening walk'}
    </h1>
    <p class="mt-4 max-w-[46ch] text-[1.02rem] leading-relaxed text-crem">
      {ro
        ? 'Hamuri, lese și genți croite în București, pe patru țesături care se poartă împreună.'
        : 'Harnesses, leads and bags cut in Bucharest, in four cloths that wear together.'}
    </p>
    <div class="mt-7 flex flex-wrap gap-3">
      <a href={u('/reduceri')} class="rounded-[10px] bg-teracota px-7 py-3.5 text-[0.92rem] text-crem transition-colors hover:bg-[#8d5031]">
        {ro ? 'Cumpără la reducere' : 'Shop the sale'}
      </a>
      <a href={u('/colectii')} class="rounded-[10px] border border-crem/55 bg-ink/50 px-7 py-3.5 text-[0.92rem] text-crem backdrop-blur-[2px] transition-colors hover:border-crem hover:bg-ink/70">
        {ro ? 'Vezi tot magazinul' : 'Browse the shop'}
      </a>
    </div>
  </div>
</section>

<!-- 2. BANDA DE ÎNCREDERE -->
<section class="border-b border-linie bg-ink text-crem" aria-label={ro ? 'Condiții de livrare' : 'Delivery terms'}>
  <ul class="container-brand grid grid-cols-2 gap-x-6 gap-y-4 py-5 lg:grid-cols-4">
    {trust.map(([titlu, text]) => (
      <li class="flex items-start gap-2.5">
        <span aria-hidden="true" class="mt-[0.5em] h-[3px] w-[12px] shrink-0 bg-camel"></span>
        <span>
          <span class="block text-[0.87rem] leading-snug">{titlu}</span>
          <span class="block text-[0.78rem] leading-snug text-crem/60">{text}</span>
        </span>
      </li>
    ))}
  </ul>
</section>

<!-- 2b. CATEGORII, sub banda de încredere -->
<section class="border-b border-linie bg-crem" aria-label={ro ? 'Categorii' : 'Categories'}>
  <ul data-apare class="container-brand flex snap-x gap-7 overflow-x-auto py-9 [scrollbar-width:none] sm:justify-center sm:gap-10 lg:gap-14">
    {tipuriPrincipale.map((tip) => (
      <li class="shrink-0 snap-start">
        <a href={u(`/categorie/${tip.slug}`)} class="group flex w-[7rem] flex-col items-center gap-3 text-center lg:w-[9rem]">
          <span class="block overflow-hidden rounded-full border border-linie bg-nisip transition-colors group-hover:border-camel">
            <Image
              src={getImagine(tip.imagine)}
              alt=""
              widths={[180, 320]}
              sizes="144px"
              loading="lazy"
              class="h-[6.5rem] w-[6.5rem] object-cover transition-transform duration-400 ease-out group-hover:scale-[1.07] lg:h-[8.5rem] lg:w-[8.5rem]"
            />
          </span>
          <span class="text-[0.86rem] leading-snug text-ciocolata/85 transition-colors group-hover:text-teracota">
            {tip.nume}
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>

<!-- 3. REDUCERI -->
<section class="bg-nisip">
  <div class="container-brand py-[var(--sectiune-strans)]">
    <div data-apare class="flex flex-wrap items-end justify-between gap-5">
      <div>
        <div class="flex items-center gap-2.5">
          <span class="rounded-[5px] bg-teracota px-2 py-1 text-[0.72rem] leading-none text-crem">
            {t('promo.oferta')}
          </span>
          <span class="text-[0.82rem] text-ciocolata/65">
            {toateReducerile.length} {ro ? 'produse' : 'products'}
          </span>
        </div>
        <h2 class="mt-3" style="font-size: var(--pas-2xl)">{t('promo.titlu')}</h2>
        <p class="mt-2 max-w-[46ch] text-[0.92rem] text-ciocolata/75">{t('promo.text')}</p>
      </div>
      <Numaratoare
        client:visible
        pana={finalOferta.toISOString()}
        etichete={{ zile: t('promo.zile'), ore: t('promo.ore'), minute: t('promo.minute'), secunde: t('promo.secunde') }}
      />
    </div>

    <div data-apare style="--pas: 90ms" class="mt-9 grid grid-cols-2 gap-x-4 gap-y-9 lg:grid-cols-4">
      {reduceri.map((p) => <CardProdus produs={p} lang={lang} />)}
    </div>

    <a href={u('/reduceri')} class="mt-9 inline-block rounded-[10px] bg-ink px-7 py-3.5 text-[0.92rem] text-crem transition-colors hover:bg-ciocolata">
      {t('promo.toate')}
    </a>
  </div>
</section>

<!-- 5. BESTSELLERS -->
<section class="container-brand sectiune">
  <div data-apare class="flex items-end justify-between gap-6">
    <h2 style="font-size: var(--pas-2xl)">{ro ? 'Cele mai vândute' : 'Bestsellers'}</h2>
    <a href={u('/colectii')} class="shrink-0 text-[0.88rem] underline underline-offset-4 hover:text-teracota">{t('nav.toate')}</a>
  </div>
  <div data-apare style="--pas: 90ms" class="mt-8 grid grid-cols-2 gap-x-4 gap-y-9 lg:grid-cols-4">
    {bestsellers.map((p) => <CardProdus produs={p} lang={lang} />)}
  </div>
</section>

<!-- 5b. BANDĂ VIDEO -->
<section class="relative isolate overflow-hidden bg-ciocolata">
  <video
    class="h-[clamp(26rem,76svh,46rem)] w-full object-cover object-[center_22%] motion-reduce:hidden"
    autoplay muted loop playsinline preload="none"
    poster={alergarePoster.src}
    aria-hidden="true"
  >
    <source src="/media/video/alergare.webm" type="video/webm" />
    <source src="/media/video/alergare.mp4" type="video/mp4" />
  </video>
  <Image
    src={alergarePoster}
    alt=""
    widths={[900, 1400, 1600]}
    sizes="100vw"
    loading="lazy"
    class="hidden h-[clamp(26rem,76svh,46rem)] w-full object-cover object-[center_22%] motion-reduce:block"
  />
  <span class="pointer-events-none absolute inset-0" style="background: linear-gradient(to top, rgba(24,22,19,0.88) 0%, rgba(24,22,19,0.66) 30%, rgba(24,22,19,0.24) 62%, transparent 100%);" aria-hidden="true"></span>
  <span class="pointer-events-none absolute inset-0 hidden md:block" style="background: linear-gradient(to right, rgba(24,22,19,0.45) 0%, rgba(24,22,19,0.1) 46%, transparent 70%);" aria-hidden="true"></span>
  <div class="container-brand absolute inset-x-0 bottom-0 pb-10">
    <h2 class="max-w-[16ch] text-crem" style="font-size: var(--pas-2xl)">
      {ro ? 'Ține la plimbări lungi' : 'Built for the long walk'}
    </h2>
    <p class="mt-2.5 max-w-[44ch] text-[0.93rem] leading-relaxed text-crem">
      {ro
        ? 'Hamul Explore are mâner de control pe spate și trei puncte de reglaj. Pentru câini care trag și pentru drumuri fără trotuar.'
        : 'The Explore harness has a control handle across the back and three adjustment points. For dogs that pull and roads without pavements.'}
    </p>
    <a href={u('/categorie/ham-explore')} class="mt-5 inline-block rounded-[10px] bg-crem px-7 py-3.5 text-[0.92rem] text-ink transition-colors hover:bg-nisip">
      {ro ? 'Vezi hamul Explore' : 'See the Explore harness'}
    </a>
  </div>
</section>

<!-- 6. BANNER LAT -->
<section class="relative isolate overflow-hidden">
  <Image
    src={getImagine('/media/banner/trio.jpg')}
    alt=""
    widths={[900, 1400, 2048]}
    sizes="100vw"
    loading="lazy"
    class="h-[clamp(20rem,48svh,30rem)] w-full object-cover"
  />
  <span class="absolute inset-0" style="background: linear-gradient(to right, rgba(24,22,19,0.82) 0%, rgba(24,22,19,0.5) 42%, rgba(24,22,19,0.15) 75%);" aria-hidden="true"></span>
  <div data-apare class="container-brand absolute inset-0 flex flex-col justify-center">
    <h2 class="max-w-[17ch] text-crem" style="font-size: var(--pas-2xl)">
      {ro ? 'Patru țesături. Aceleași opt piese.' : 'Four cloths. The same eight pieces.'}
    </h2>
    <p class="mt-3 max-w-[44ch] text-[0.95rem] leading-relaxed text-crem">
      {ro
        ? 'Alegi o țesătură și completezi setul când vrei. Le ținem în stoc tot anul, deci prinzi aceeași nuanță și peste șase luni.'
        : 'Pick a cloth and complete the set whenever you like. We keep them in stock all year, so you get the same shade six months later.'}
    </p>
    <a href={u('/colectii')} class="mt-6 w-fit rounded-[10px] bg-crem px-7 py-3.5 text-[0.92rem] text-ink transition-colors hover:bg-nisip">
      {ro ? 'Alege țesătura' : 'Pick your cloth'}
    </a>
  </div>
</section>

<!-- 7. COLECȚII -->
<section class="container-brand sectiune">
  <h2 style="font-size: var(--pas-2xl)">{ro ? 'Colecțiile' : 'The collections'}</h2>
  <div data-apare class="mt-8 grid gap-4 sm:grid-cols-2">
    {colectii.map((c) => (
      <a href={u(`/colectie/${c.slug}`)} class="group relative block overflow-hidden rounded-[14px] bg-nisip">
        <Image
          src={getImagine(c.imagine)}
          alt=""
          widths={[500, 900]}
          sizes="(min-width: 640px) 46vw, 92vw"
          loading="lazy"
          class="aspect-[16/10] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
        />
        <span class="pointer-events-none absolute inset-0" style="background: linear-gradient(to top, rgba(24,22,19,0.78), rgba(24,22,19,0.12) 60%, transparent);" aria-hidden="true"></span>
        <span class="absolute inset-x-0 bottom-0 p-5">
          <span class="block font-[family-name:var(--font-serif)] text-[1.5rem] leading-tight text-crem">{c.nume}</span>
          <span class="mt-1 block max-w-[40ch] text-[0.83rem] leading-snug text-crem/75">{c.tesatura}</span>
        </span>
      </a>
    ))}
  </div>
</section>

<!-- 8. NOUTĂȚI -->
{noutati.length > 0 && (
  <section class="container-brand sectiune pt-0">
    <h2 style="font-size: var(--pas-2xl)">{ro ? 'Intrate în stoc' : 'Just landed'}</h2>
    <div data-apare class="mt-8 grid grid-cols-2 gap-x-4 gap-y-9 lg:grid-cols-4">
      {noutati.map((p) => <CardProdus produs={p} lang={lang} />)}
    </div>
  </section>
)}

<!-- 9. ATELIER -->
<section class="bg-nisip">
  <div data-apare class="container-brand sectiune grid items-center gap-10 md:grid-cols-[1.05fr_0.95fr] md:gap-14">
    <div>
      <h2 style="font-size: var(--pas-2xl)">
        {ro ? 'Croite în București, testate la 187 kg' : 'Cut in Bucharest, pull-tested to 187 kg'}
      </h2>
      <p class="mt-4 max-w-[50ch] leading-relaxed text-ciocolata/80">
        {ro
          ? 'Fiecare chingă trece printr-un test de tracțiune înainte să iasă din atelier. Nu pentru că un câine trage atât, ci pentru că lesa se agață în portbagaj, în ușă, în gard.'
          : 'Every strap goes through a pull test before it leaves the workshop. Not because a dog pulls that hard, but because leads catch on boot lids, doors and fences.'}
      </p>
      <ul class="mt-6 space-y-2.5 text-[0.92rem]">
        {(ro
          ? ['Cusătură în X pe patru rânduri, la fiecare punct de prindere',
             'Catarame din alamă, nu din zamac vopsit',
             'Inele D sudate, nu doar îndoite']
          : ['Four-row cross stitch at every load point',
             'Brass buckles, not painted zinc alloy',
             'Welded D-rings, not merely bent closed']
        ).map((linie) => (
          <li class="flex gap-3 border-b border-linie pb-2.5">
            <span aria-hidden="true" class="mt-[0.55em] h-[3px] w-[14px] shrink-0 bg-teracota"></span>
            <span class="text-ciocolata/85">{linie}</span>
          </li>
        ))}
      </ul>
      <a href={u('/poveste')} class="mt-7 inline-block rounded-[10px] border border-ciocolata/25 px-6 py-3 text-[0.9rem] transition-colors hover:border-ciocolata">
        {ro ? 'Cum sunt făcute' : 'How they are made'}
      </a>
    </div>
    <div class="overflow-hidden rounded-[14px]">
      <Image
        src={getImagine('/media/banner/atelier.jpg')}
        alt=""
        widths={[600, 1000]}
        sizes="(min-width: 768px) 46vw, 92vw"
        loading="lazy"
        class="aspect-[4/3] w-full object-cover"
      />
    </div>
  </div>
</section>

<!-- 10. DE LA CLIENȚI -->
<section class="sectiune">
  <div class="container-brand flex flex-wrap items-end justify-between gap-4">
    <h2 style="font-size: var(--pas-2xl)">{ro ? 'De la oamenii care le poartă' : 'From the people who wear them'}</h2>
    <p class="text-[0.85rem] text-ciocolata/60">#hoinarpelume</p>
  </div>
  <div data-apare class="mt-7 grid grid-cols-2 gap-2 px-[clamp(1rem,0.5rem+2.5vw,3rem)] sm:grid-cols-5 sm:gap-3">
    {ugc.map((cale, i) => (
      <div class={`overflow-hidden rounded-[10px] bg-nisip ${i > 3 ? 'hidden sm:block' : ''}`}>
        <Image
          src={getImagine(cale)}
          alt=""
          widths={[300, 520]}
          sizes="(min-width: 640px) 19vw, 46vw"
          loading="lazy"
          class="aspect-square w-full object-cover transition-transform duration-500 ease-out hover:scale-[1.05]"
        />
      </div>
    ))}
  </div>

  <div data-apare style="--pas: 120ms" class="container-brand mt-10 grid gap-4 md:grid-cols-3">
    {recenzii.slice(0, 3).map((r) => (
      <figure class="rounded-[10px] border border-linie p-5">
        <Stele n={r.stele} marime={13} />
        <blockquote class="mt-3 text-[0.9rem] leading-relaxed text-ciocolata/85">{r.text}</blockquote>
        <figcaption class="mt-4 text-[0.8rem] text-ciocolata/60">{r.nume}, {r.oras}</figcaption>
      </figure>
    ))}
  </div>
</section>

<!-- 11. NEWSLETTER -->
<section class="bg-ciocolata text-crem">
  <div class="container-brand grid items-center gap-8 py-14 md:grid-cols-[1fr_1fr] md:gap-14">
    <div>
      <span class="rounded-[5px] bg-teracota px-2 py-1 text-[0.72rem] leading-none">
        {ro ? '−10% la prima comandă' : '−10% on your first order'}
      </span>
      <h2 class="mt-4 text-crem" style="font-size: var(--pas-2xl)">
        {ro ? 'Scrie-ne o dată pe lună' : 'One letter a month'}
      </h2>
      <p class="mt-3 max-w-[44ch] text-[0.93rem] leading-relaxed text-crem/75">
        {ro
          ? 'Îți trimitem codul de 10% imediat, apoi o singură scrisoare pe lună: țesături noi și reduceri. Te dezabonezi când vrei.'
          : 'We send the 10% code straight away, then one letter a month: new cloths and sales. Unsubscribe whenever you like.'}
      </p>
    </div>
    <form class="flex flex-col gap-2.5 sm:flex-row" data-newsletter>
      <label class="sr-only" for="email-newsletter">{t('sec.email')}</label>
      <input
        id="email-newsletter"
        type="email"
        required
        placeholder={t('sec.email')}
        class="min-w-0 flex-1 rounded-[10px] border border-crem/25 bg-crem/10 px-4 py-3.5 text-[0.92rem] text-crem outline-none placeholder:text-crem/45 focus:border-crem/60"
      />
      <button type="submit" class="rounded-[10px] bg-teracota px-7 py-3.5 text-[0.92rem] text-crem transition-colors hover:bg-[#8d5031]">
        {ro ? 'Vreau codul' : 'Send the code'}
      </button>
    </form>
    <p class="hidden text-[0.9rem] text-camel md:col-start-2" data-newsletter-ok>
      {ro ? 'Gata. Codul HOINAR10 e valabil 30 de zile.' : 'Done. The code HOINAR10 is valid for 30 days.'}
    </p>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-newsletter]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    form.hidden = true;
    document.querySelector<HTMLElement>('[data-newsletter-ok]')?.classList.remove('hidden');
  });
</script>
